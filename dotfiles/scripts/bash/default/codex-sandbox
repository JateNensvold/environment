#!/usr/bin/env bash
# codex-sandbox.sh — Rootless sandbox for Codex CLI
#
# Isolates: filesystem, PID, IPC, UTS, user
# Shares:   host network (simple, reliable, no slirp4netns)
#
# Visible inside sandbox:
#   /nix/store       — copy-on-write Nix store managed through local-overlay
#   /workspace       — read-write active workspace
#   /home/$USER/environment — read-only repo source for live global-agent links
#   /home/$USER/.agents — read-only (shared workflow definitions)
#   /home/$USER/.codex — read-write (persistent global config)
#   /nix             — copy-on-write view: host Nix is read-only; a per-user temp upper layer
#                      retains sandbox Nix mutations until the host temp directory is cleaned
#   Nix cache/config/state paths — copy-on-write views over their host equivalents
#   Nix profiles      — sandbox-local profile state
#   /proc /dev /tmp /run — essentials
#   /etc/{resolv.conf,ssl,passwd,group} — networking & identity
#   Optional: a temporary ssh-agent socket plus ~/.ssh/{config,known_hosts} when
#   launched with --ssh-key /path/to/key
#   If the workspace uses `direnv` with `use flake`, Bash commands source
#   `direnv export bash`, which reuses the repo-local `.direnv/` cache
# Everything else (home, usr, etc, other projects, docker socket) — gone

set -euo pipefail

WORKSPACE_HOST="$(pwd)"
WORKSPACE_SANDBOX="/workspace"
ENVIRONMENT_REPO=""
ENVIRONMENT_BIND_ARGS=()
CODEX_ARGS=()
DNS_DEBUG=0
NIX_ENV_MODE=""
SSH_KEY_PATH=""
SSH_AGENT_BIN=""
SSH_ADD_BIN=""
SSH_AGENT_DIR=""
SSH_AGENT_PID_VALUE=""
SSH_AGENT_SOCKET_HOST=""
SSH_AGENT_SOCKET_SANDBOX=""
NIX_BASH_ENV_HOST=""
NIX_BASH_ENV_SANDBOX="/home/$USER/.codex/direnv/bashenv.sh"
NIX_ENV_ARGS=()
NIX_FALLBACK_DIR="/tmp/codex-sandbox-nix-$UID"
NIX_CONTROL_DIR="$NIX_FALLBACK_DIR/control"
NIX_MOUNT_ROOT="$NIX_FALLBACK_DIR/mount"
NIX_BROKER_SCRIPT=""
NIX_BROKER_PID=""
NIX_BROKER_LOCK_FD=""
NIX_LEASE=""

log_sandbox_header() {
	printf '[sandbox]\n' >&2
}

log_sandbox_detail() {
	printf '  %s\n' "$1" >&2
}

cleanup_ssh_agent() {
	[[ -n "${SSH_AGENT_PID_VALUE:-}" ]] || return 0

	SSH_AGENT_PID="$SSH_AGENT_PID_VALUE" \
		SSH_AUTH_SOCK="$SSH_AGENT_SOCKET_HOST" \
		"$SSH_AGENT_BIN" -k >/dev/null 2>&1 || true
	rm -rf "$SSH_AGENT_DIR"
}

cleanup_sandbox() {
	release_nix_broker
	cleanup_ssh_agent
}

setup_ssh_agent() {
	local key_path="$1"
	local ssh_agent_output

	SSH_AGENT_BIN="$(resolve_bin ssh-agent)"
	SSH_ADD_BIN="$(resolve_bin ssh-add)"

	SSH_AGENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/codex-sandbox-ssh.XXXXXX")"
	SSH_AGENT_SOCKET_HOST="$SSH_AGENT_DIR/agent.sock"
	SSH_AGENT_SOCKET_SANDBOX="/tmp/codex-sandbox-ssh/agent.sock"

	ssh_agent_output="$("$SSH_AGENT_BIN" -s -a "$SSH_AGENT_SOCKET_HOST")"
	eval "$ssh_agent_output" >/dev/null
	SSH_AGENT_PID_VALUE="${SSH_AGENT_PID:-}"
	[[ -n "$SSH_AGENT_PID_VALUE" && -S "$SSH_AGENT_SOCKET_HOST" ]] || {
		echo "ERROR: failed to start temporary ssh-agent" >&2
		exit 1
	}

	"$SSH_ADD_BIN" "$key_path"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--workspace)
		WORKSPACE_HOST="$2"
		shift 2
		;;
	--no-nix-env)
		NIX_ENV_MODE="disabled"
		shift
		;;
	--dns-debug)
		DNS_DEBUG=1
		shift
		;;
	--ssh-key)
		SSH_KEY_PATH="$2"
		shift 2
		;;
	*)
		CODEX_ARGS+=("$1")
		shift
		;;
	esac
done

WORKSPACE_HOST="$(realpath "$WORKSPACE_HOST")"
[[ -d "$WORKSPACE_HOST" ]] || {
	echo "ERROR: Workspace '$WORKSPACE_HOST' not found" >&2
	exit 1
}

ENVIRONMENT_REPO="$(realpath "$HOME/environment")"
[[ -d "$ENVIRONMENT_REPO" ]] || {
	echo "ERROR: Environment repo '$ENVIRONMENT_REPO' not found" >&2
	exit 1
}
ENVIRONMENT_BIND_ARGS=(--ro-bind "$ENVIRONMENT_REPO" "$ENVIRONMENT_REPO")

if [[ -n "$SSH_KEY_PATH" ]]; then
	SSH_KEY_PATH="$(realpath "$SSH_KEY_PATH")"
	[[ -f "$SSH_KEY_PATH" ]] || {
		echo "ERROR: SSH key '$SSH_KEY_PATH' not found" >&2
		exit 1
	}
fi

resolve_bin() {
	local path
	path="$(command -v "$1" 2>/dev/null)" || {
		echo "ERROR: '$1' not found" >&2
		exit 1
	}
	readlink -f "$path"
}

add_path_dir() {
	local dir="$1"
	[[ -d "$dir" ]] || return 0

	if [[ -z "${SEEN[$dir]:-}" ]]; then
		SEEN[$dir]=1
		SANDBOX_PATH="${SANDBOX_PATH:+$SANDBOX_PATH:}$dir"
	fi
}

resolve_current_bash() {
	[[ -n "${BASH:-}" ]] || {
		echo "ERROR: BASH is not set" >&2
		exit 1
	}
	readlink -f "$BASH"
}

ensure_owned_directory() {
	local directory="$1"

	if [[ -L "$directory" ]]; then
		echo "ERROR: Nix overlay path '$directory' must not be a symlink" >&2
		exit 1
	fi

	if [[ ! -e "$directory" ]]; then
		mkdir -m 700 "$directory" 2>/dev/null || true
	fi

	[[ -d "$directory" && ! -L "$directory" && -O "$directory" ]] || {
		echo "ERROR: Nix overlay path '$directory' must be a directory owned by the current user" >&2
		exit 1
	}

	chmod 700 "$directory"
}

process_start_time() {
	local pid="$1"

	[[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
	awk '{ print $22 }' "/proc/$pid/stat"
}

broker_is_live() {
	local pid
	local start_time
	local current_start_time

	[[ -r "$NIX_CONTROL_DIR/broker" ]] || return 1
	read -r pid start_time <"$NIX_CONTROL_DIR/broker" || return 1
	[[ "$pid" =~ ^[0-9]+$ && "$start_time" =~ ^[0-9]+$ ]] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	current_start_time="$(process_start_time "$pid")" || return 1
	[[ "$current_start_time" == "$start_time" ]] || return 1
	[[ -e "/proc/$pid/ns/user" && -e "/proc/$pid/ns/mnt" ]] || return 1
	NIX_BROKER_PID="$pid"
}

lease_is_live() {
	local lease="$1"
	local pid
	local start_time
	local current_start_time

	[[ -r "$lease" ]] || return 1
	read -r pid start_time <"$lease" || return 1
	[[ "$pid" =~ ^[0-9]+$ && "$start_time" =~ ^[0-9]+$ ]] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	current_start_time="$(process_start_time "$pid")" || return 1
	[[ "$current_start_time" == "$start_time" ]]
}

reap_stale_leases() {
	local lease

	shopt -s nullglob
	for lease in "$NIX_CONTROL_DIR/leases"/lease.*; do
		lease_is_live "$lease" || unlink "$lease" 2>/dev/null || true
	done
	shopt -u nullglob
}

has_active_leases() {
	local lease

	shopt -s nullglob
	for lease in "$NIX_CONTROL_DIR/leases"/lease.*; do
		shopt -u nullglob
		return 0
	done
	shopt -u nullglob
	return 1
}

wait_for_broker_exit() {
	if broker_is_live; then
		kill -TERM "$NIX_BROKER_PID" 2>/dev/null || true
	fi

	for _ in {1..100}; do
		broker_is_live || break
		sleep 0.05
	done

	if broker_is_live; then
		kill -KILL "$NIX_BROKER_PID" 2>/dev/null || true
		for _ in {1..20}; do
			broker_is_live || break
			sleep 0.05
		done
	fi

	if broker_is_live; then
		echo "ERROR: sandbox Nix broker did not exit; refusing to start another broker" >&2
		return 1
	fi
}

stop_broker_locked() {
	: >"$NIX_CONTROL_DIR/stopping"
	wait_for_broker_exit || return 1
	unlink "$NIX_CONTROL_DIR/ready" 2>/dev/null || true
	unlink "$NIX_CONTROL_DIR/broker" 2>/dev/null || true
	unlink "$NIX_CONTROL_DIR/stopping" 2>/dev/null || true
	NIX_BROKER_PID=""
}

wait_for_broker_ready() {
	for _ in {1..100}; do
		if [[ -e "$NIX_CONTROL_DIR/ready" ]] && broker_is_live; then
			return 0
		fi
		if [[ -s "$NIX_CONTROL_DIR/broker.log" ]] && ! broker_is_live; then
			break
		fi
		sleep 0.05
	done

	echo "ERROR: sandbox Nix broker did not become ready; see $NIX_CONTROL_DIR/broker.log" >&2
	if [[ -s "$NIX_CONTROL_DIR/broker.log" ]]; then
		echo "--- broker log ---" >&2
		while IFS= read -r line; do
			printf '%s\n' "$line" >&2
		done <"$NIX_CONTROL_DIR/broker.log"
	fi
	if [[ -s "$NIX_CONTROL_DIR/daemon.log" ]]; then
		echo "--- daemon log ---" >&2
		while IFS= read -r line; do
			printf '%s\n' "$line" >&2
		done <"$NIX_CONTROL_DIR/daemon.log"
	fi
	return 1
}

start_broker_locked() {
	unlink "$NIX_CONTROL_DIR/ready" 2>/dev/null || true
	unlink "$NIX_CONTROL_DIR/broker" 2>/dev/null || true
	unlink "$NIX_CONTROL_DIR/stopping" 2>/dev/null || true
	: >"$NIX_CONTROL_DIR/broker.log"
	: >"$NIX_CONTROL_DIR/daemon.log"

	"$UNSHARE" --user --map-root-user --mount --propagation private \
		"$NIX_BROKER_SCRIPT" \
		--root "$NIX_FALLBACK_DIR" \
		--control "$NIX_CONTROL_DIR" \
		--nix "$NIX_BIN" \
		--flock "$FLOCK" \
		--mount "$MOUNT" \
		--umount "$UMOUNT" \
		>>"$NIX_CONTROL_DIR/broker.log" 2>&1 &

	wait_for_broker_ready
}

create_nix_lease_locked() {
	local start_time

	start_time="$(process_start_time "$$")" || {
		echo "ERROR: cannot determine sandbox wrapper process identity" >&2
		return 1
	}
	NIX_LEASE="$(mktemp "$NIX_CONTROL_DIR/leases/lease.XXXXXX")"
	printf '%s %s\n' "$$" "$start_time" >"$NIX_LEASE"
}

setup_nix_broker() {
	ensure_owned_directory "$NIX_FALLBACK_DIR"
	ensure_owned_directory "$NIX_CONTROL_DIR"
	ensure_owned_directory "$NIX_CONTROL_DIR/leases"

	exec {NIX_BROKER_LOCK_FD}>"$NIX_CONTROL_DIR/lock"
	"$FLOCK" -x "$NIX_BROKER_LOCK_FD"

	reap_stale_leases
	if [[ -e "$NIX_CONTROL_DIR/stopping" ]]; then
		stop_broker_locked || return 1
	fi

	if ! [[ -e "$NIX_CONTROL_DIR/ready" ]] || ! broker_is_live; then
		if broker_is_live; then
			stop_broker_locked || return 1
		fi
		start_broker_locked || return 1
	fi

	create_nix_lease_locked || return 1
	"$FLOCK" -u "$NIX_BROKER_LOCK_FD"
	exec {NIX_BROKER_LOCK_FD}>&-
	NIX_BROKER_LOCK_FD=""
}

release_nix_broker() {
	[[ -n "${NIX_LEASE:-}" ]] || return 0

	exec {NIX_BROKER_LOCK_FD}>"$NIX_CONTROL_DIR/lock"
	"$FLOCK" -x "$NIX_BROKER_LOCK_FD"
	unlink "$NIX_LEASE" 2>/dev/null || true
	NIX_LEASE=""
	reap_stale_leases
	if ! has_active_leases; then
		stop_broker_locked || return 1
	fi
	"$FLOCK" -u "$NIX_BROKER_LOCK_FD"
	exec {NIX_BROKER_LOCK_FD}>&-
	NIX_BROKER_LOCK_FD=""
}

workspace_uses_flake_env() {
	local envrc_path="$WORKSPACE_HOST/.envrc"
	local line

	[[ -f "$envrc_path" ]] || return 1

	while IFS= read -r line; do
		case "$line" in
		*use\ flake*) return 0 ;;
		esac
	done <"$envrc_path"

	return 1
}

setup_nix_bash_env() {
	local helper_dir_host

	helper_dir_host="$HOME/.codex/direnv"

	mkdir -p "$helper_dir_host"

	NIX_BASH_ENV_HOST="$helper_dir_host/bashenv.sh"

	cat >"$NIX_BASH_ENV_HOST" <<'EOF'
#!/usr/bin/env bash

__codex_nix_workspace="${CODEX_SANDBOX_WORKSPACE:-}"
__codex_nix_profile_bin="${CODEX_SANDBOX_NIX_PROFILE_BIN:-}"
__codex_direnv_bin="${CODEX_SANDBOX_DIRENV_BIN:-}"

if [[ -n "$__codex_nix_workspace" && -n "$__codex_nix_profile_bin" && -n "$__codex_direnv_bin" && -z "${CODEX_SANDBOX_DIRENV_LOADING:-}" ]]; then
	export CODEX_SANDBOX_DIRENV_LOADING=1
	export PATH="$__codex_nix_profile_bin${PATH:+:$PATH}"
	__codex_nix_export="$(
		unset BASH_ENV
		cd "$__codex_nix_workspace" &&
			"$__codex_direnv_bin" export bash
	)" || {
		unset CODEX_SANDBOX_DIRENV_LOADING
		return 0
	}

	if [[ -n "$__codex_nix_export" ]]; then
		eval "$__codex_nix_export"
	fi

	unset CODEX_SANDBOX_DIRENV_LOADING
fi

unset __codex_nix_export __codex_nix_workspace __codex_nix_profile_bin __codex_direnv_bin
EOF

	chmod 700 "$NIX_BASH_ENV_HOST"
}

BWRAP="$(resolve_bin bwrap)"
SANDBOX_SHELL="$(resolve_bin "$(basename "${SHELL:-zsh}")")"
SANDBOX_SHELL_NAME="$(basename "$SANDBOX_SHELL")"
CODEX="$(resolve_bin codex)"
NODE="$(resolve_bin node)"
CAT="$(resolve_bin cat)"
ENV_BIN="$(resolve_bin env)"
BASH_BIN="$(resolve_current_bash)"
SH_BIN="$BASH_BIN"
DIRENV_BIN="$(resolve_bin direnv)"
FLOCK="$(resolve_bin flock)"
UNSHARE="$(resolve_bin unshare)"
NSENTER="$(resolve_bin nsenter)"
MOUNT="$(resolve_bin mount)"
UMOUNT="$(resolve_bin umount)"
NIX_BIN="$(resolve_bin nix)"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
NIX_BROKER_SCRIPT="$(dirname "$SCRIPT_PATH")/codex-sandbox-broker"
[[ -x "$NIX_BROKER_SCRIPT" ]] || {
	echo "ERROR: sandbox broker '$NIX_BROKER_SCRIPT' is missing or not executable" >&2
	exit 1
}

# Resolve nix profile bin directory — all nix-installed programs live here as
# symlinks into /nix/store (which is already ro-mounted), so a single PATH
# entry gives the sandbox access to everything installed via nix/home-manager.
NIX_PROFILE_BIN="$(readlink -f "$HOME/.nix-profile/bin")"
[[ -d "$NIX_PROFILE_BIN" ]] || {
	echo "ERROR: nix profile bin not found at $NIX_PROFILE_BIN" >&2
	exit 1
}

# Build deduplicated PATH from hard dependencies, host PATH entries that resolve
# into /nix/store, and the nix profile bin.
declare -A SEEN
SANDBOX_PATH=""

for entry in "$CODEX" "$NODE" "$SANDBOX_SHELL" "$CAT" "$ENV_BIN" "$BASH_BIN" "$SH_BIN" "$DIRENV_BIN"; do
	add_path_dir "$(dirname "$entry")"
done

IFS=':' read -r -a HOST_PATH_ENTRIES <<<"${PATH:-}"
for entry in "${HOST_PATH_ENTRIES[@]}"; do
	[[ -n "$entry" && -d "$entry" ]] || continue
	resolved="$(readlink -f "$entry" 2>/dev/null || true)"
	[[ -d "$resolved" ]] || continue

	case "$resolved" in
	/nix/store/*) add_path_dir "$resolved" ;;
	esac
done

add_path_dir "$NIX_PROFILE_BIN"

# Resolve resolv.conf (may be symlink under systemd-resolved)
RESOLV="$(readlink -f /etc/resolv.conf)"

# Pass through API keys if set
ENV_ARGS=()
for var in OPENAI_API_KEY GITHUB_TOKEN; do
	[[ -n "${!var:-}" ]] && ENV_ARGS+=(--setenv "$var" "${!var}")
done

# Ensure persistent host-backed directories exist for bind mounts
mkdir -p \
	"$HOME/.codex" \
	"$HOME/.cache/nix" \
	"$HOME/.config/direnv" \
	"$HOME/.config/nix" \
	"$HOME/.local/share/direnv" \
	"$HOME/.local/share/nix" \
	"$HOME/.local/state/nix"

# The fallback tree is intentionally outside the host home mount. Its upper
# layers survive broker restarts, while one private broker mounts them once and
# serves every concurrent sandbox through its own Nix daemon.
setup_nix_broker || exit 1
trap cleanup_sandbox EXIT

AGENTS_BIND_ARGS=(--dir "/home/$USER/.agents")
if [[ -e "$HOME/.agents" ]]; then
	AGENTS_BIND_ARGS=(--ro-bind "$HOME/.agents" "/home/$USER/.agents")
fi

HOME_DIR_ARGS=(
	--dir "/home/$USER/.nix-profile"
	--dir "/home/$USER/.cache"
	--dir "/home/$USER/.config"
	--dir "/home/$USER/.local"
	--dir "/home/$USER/.local/share"
	--dir "/home/$USER/.local/share/nix"
	--dir "/home/$USER/.local/state"
)

NIX_BIND_ARGS=(
	--bind "$HOME/.config/direnv" "/home/$USER/.config/direnv"
	--bind "$HOME/.local/share/direnv" "/home/$USER/.local/share/direnv"
	--bind "$NIX_MOUNT_ROOT/home/cache-nix" "/home/$USER/.cache/nix"
	--bind "$NIX_MOUNT_ROOT/home/config-nix" "/home/$USER/.config/nix"
	--bind "$NIX_MOUNT_ROOT/home/share-nix" "/home/$USER/.local/share/nix"
	--bind "$NIX_MOUNT_ROOT/home/state-nix" "/home/$USER/.local/state/nix"
)

SSH_HOME_DIR_ARGS=()
SSH_BIND_ARGS=()
SSH_ENV_ARGS=()
if [[ -n "$SSH_KEY_PATH" ]]; then
	setup_ssh_agent "$SSH_KEY_PATH"
	SSH_HOME_DIR_ARGS=(--dir "/home/$USER/.ssh")
	SSH_BIND_ARGS=(
		--dir /tmp/codex-sandbox-ssh
		--bind "$SSH_AGENT_SOCKET_HOST" "$SSH_AGENT_SOCKET_SANDBOX"
	)
	SSH_ENV_ARGS=(--setenv SSH_AUTH_SOCK "$SSH_AGENT_SOCKET_SANDBOX")

	if [[ -f "$HOME/.ssh/known_hosts" ]]; then
		SSH_BIND_ARGS+=(--ro-bind "$HOME/.ssh/known_hosts" "/home/$USER/.ssh/known_hosts")
	fi

	if [[ -f "$HOME/.ssh/config" ]]; then
		SSH_BIND_ARGS+=(--ro-bind "$HOME/.ssh/config" "/home/$USER/.ssh/config")
	fi
fi

if [[ "$NIX_ENV_MODE" != "disabled" ]]; then
	if workspace_uses_flake_env; then
		NIX_ENV_MODE="direnv"
	fi

	if [[ -n "$NIX_ENV_MODE" ]]; then
		setup_nix_bash_env
		NIX_ENV_ARGS=(
			--setenv CODEX_SANDBOX_WORKSPACE "$WORKSPACE_SANDBOX"
			--setenv CODEX_SANDBOX_NIX_PROFILE_BIN "$NIX_PROFILE_BIN"
			--setenv CODEX_SANDBOX_DIRENV_BIN "$DIRENV_BIN"
			--setenv BASH_ENV "$NIX_BASH_ENV_SANDBOX"
		)
	fi
fi

log_sandbox_header
log_sandbox_detail "workspace: $WORKSPACE_HOST -> $WORKSPACE_SANDBOX"
log_sandbox_detail "nix overlay: shared broker (pid $NIX_BROKER_PID)"
if [[ -n "$NIX_ENV_MODE" ]]; then
	log_sandbox_detail "nix env: $NIX_ENV_MODE preload enabled"
fi

SANDBOX_CMD=("$CODEX" "${CODEX_ARGS[@]}")
if [[ "$DNS_DEBUG" -eq 1 ]]; then
	log_sandbox_detail "running DNS diagnostics..."
	SANDBOX_CMD=(/bin/bash -lc '
			echo "== curl -I https://1.1.1.1 =="
			curl -I --max-time 10 https://1.1.1.1 || true
			echo
			echo "== doggo www.google.com =="
			doggo www.google.com || true
			echo
			echo "== ls /etc =="
			ls -la /etc || true
			echo
			echo "== ls /run /run/systemd /run/systemd/resolve =="
			ls -la /run /run/systemd /run/systemd/resolve 2>/dev/null || true
		')
else
	log_sandbox_detail "starting codex..."
fi

if [[ -n "$SSH_KEY_PATH" ]]; then
	log_sandbox_detail "ssh: temporary agent enabled for key $SSH_KEY_PATH"
fi

"$NSENTER" --preserve-credentials --user --mount --target "$NIX_BROKER_PID" -- "$BWRAP" \
	--unshare-user \
	--unshare-pid \
	--unshare-ipc \
	--unshare-uts \
	--hostname codex-sandbox \
	--dir /nix \
	--bind /nix /nix \
	--dir /nix-lower \
	--ro-bind "$NIX_MOUNT_ROOT/lower/nix" /nix-lower \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--tmpfs /run \
	--tmpfs "/home/$USER" \
	--dir "$WORKSPACE_SANDBOX" \
	"${HOME_DIR_ARGS[@]}" \
	"${SSH_HOME_DIR_ARGS[@]}" \
	--dir /usr \
	--dir /usr/bin \
	--dir /bin \
	--bind "$NIX_FALLBACK_DIR/daemon-socket" /nix/var/nix/daemon-socket \
	--ro-bind "$ENV_BIN" /usr/bin/env \
	--ro-bind "$BASH_BIN" /bin/bash \
	--ro-bind "$SH_BIN" /bin/sh \
	--ro-bind "$SANDBOX_SHELL" "/bin/$SANDBOX_SHELL_NAME" \
	"${ENVIRONMENT_BIND_ARGS[@]}" \
	--bind "$WORKSPACE_HOST" "$WORKSPACE_SANDBOX" \
	"${AGENTS_BIND_ARGS[@]}" \
	--bind "$HOME/.codex" "/home/$USER/.codex" \
	"${NIX_BIND_ARGS[@]}" \
	"${SSH_BIND_ARGS[@]}" \
	--ro-bind "$RESOLV" /etc/resolv.conf \
	--ro-bind /etc/ssl /etc/ssl \
	--ro-bind /etc/passwd /etc/passwd \
	--ro-bind /etc/group /etc/group \
	--chdir "$WORKSPACE_SANDBOX" \
	--setenv HOME "/home/$USER" \
	--setenv SHELL "/bin/$SANDBOX_SHELL_NAME" \
	--setenv TERM "${TERM:-xterm-256color}" \
	--setenv PATH "$SANDBOX_PATH" \
	--setenv LANG "${LANG:-en_US.UTF-8}" \
	--setenv NIX_SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt \
	--setenv NIX_REMOTE daemon \
	--setenv NIX_DAEMON_SOCKET_PATH /nix/var/nix/daemon-socket/socket \
	--setenv NIX_PROFILES "/nix/var/nix/profiles/default /home/$USER/.local/state/nix/profiles/profile" \
	--setenv CODEX_SANDBOX_NIX_OVERLAY_MODE shared \
	"${NIX_ENV_ARGS[@]}" \
	"${ENV_ARGS[@]}" \
	"${SSH_ENV_ARGS[@]}" \
	-- "${SANDBOX_CMD[@]}"
# -- "zsh" "-c" "ls"
# -- "ls" "-la" "$SHELL"
# -- "cat" "../.codex/auth.json"
# -- "ls" "-la" "../.codex"
