#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091,SC2034 # Dynamic broker source consumes shared globals.
# Rootless Codex CLI sandbox. The host network is shared; filesystem, PID,
# IPC, UTS, and user namespaces are isolated.

set -euo pipefail

WORKSPACE_HOST="$(pwd)"
WORKSPACE_SANDBOX_ROOT="/workspace"
WORKSPACE_SANDBOX=""
ENVIRONMENT_REPO=""
CODEX_ARGS=()
DNS_DEBUG=0
NIX_ENV_MODE=""
SSH_KEY_PATH=""
SSH_AGENT_BIN=""
SSH_AGENT_DIR=""
SSH_AGENT_PID_VALUE=""
SSH_AGENT_SOCKET_HOST=""
SSH_AGENT_SOCKET_SANDBOX=""
NIX_BASH_ENV_HOST=""
NIX_BASH_ENV_SANDBOX="/home/$USER/.codex/direnv/bashenv.sh"
NIX_FALLBACK_DIR="/tmp/codex-sandbox-nix-$UID"
NIX_CONTROL_DIR="$NIX_FALLBACK_DIR/control"
NIX_MOUNT_ROOT="$NIX_FALLBACK_DIR/mount"
NIX_BROKER_SCRIPT=""
NIX_BROKER_PID=""
NIX_LEASE=""

die() {
	printf 'ERROR: %s\n' "$1" >&2
	exit 1
}

log_sandbox_detail() {
	printf '  %s\n' "$1" >&2
}

resolve_bin() {
	local path

	path="$(command -v "$1" 2>/dev/null)" || die "'$1' not found"
	readlink -f "$path"
}

resolve_current_bash() {
	[[ -n "${BASH:-}" ]] || die "BASH is not set"
	readlink -f "$BASH"
}

parse_options() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--workspace)
			[[ $# -ge 2 ]] || die "--workspace requires a path"
			WORKSPACE_HOST="$2"
			shift 2
			;;
		--no-nix-env)
			NIX_ENV_MODE="disabled"
			shift
			;;
		--dns-debug)
			DNS_DEBUG=1
			shift
			;;
		--ssh-key)
			[[ $# -ge 2 ]] || die "--ssh-key requires a path"
			SSH_KEY_PATH="$2"
			shift 2
			;;
		*)
			CODEX_ARGS+=("$1")
			shift
			;;
		esac
	done
}

validate_inputs() {
	local workspace_name

	WORKSPACE_HOST="$(realpath "$WORKSPACE_HOST")"
	[[ -d "$WORKSPACE_HOST" ]] || die "Workspace '$WORKSPACE_HOST' not found"
	[[ "$WORKSPACE_HOST" != "/" ]] || die "Refusing to use the filesystem root as a workspace"
	workspace_name="$(basename "$WORKSPACE_HOST")"
	WORKSPACE_SANDBOX="$WORKSPACE_SANDBOX_ROOT/$workspace_name"

	ENVIRONMENT_REPO="$(realpath "$HOME/environment")"
	[[ -d "$ENVIRONMENT_REPO" ]] || die "Environment repo '$ENVIRONMENT_REPO' not found"

	if [[ -n "$SSH_KEY_PATH" ]]; then
		SSH_KEY_PATH="$(realpath "$SSH_KEY_PATH")"
		[[ -f "$SSH_KEY_PATH" ]] || die "SSH key '$SSH_KEY_PATH' not found"
	fi
}

add_path_dir() {
	local dir="$1"

	[[ -d "$dir" && -z "${SEEN[$dir]:-}" ]] || return 0
	SEEN[$dir]=1
	SANDBOX_PATH="${SANDBOX_PATH:+$SANDBOX_PATH:}$dir"
}

resolve_dependencies() {
	BWRAP="$(resolve_bin bwrap)"
	SANDBOX_SHELL="$(resolve_bin "$(basename "${SHELL:-zsh}")")"
	SANDBOX_SHELL_NAME="$(basename "$SANDBOX_SHELL")"
	CODEX="$(resolve_bin codex)"
	NODE="$(resolve_bin node)"
	GIT="$(resolve_bin git)"
	PYTHON3="$(resolve_bin python3)"
	CAT="$(resolve_bin cat)"
	ENV_BIN="$(resolve_bin env)"
	BASH_BIN="$(resolve_current_bash)"
	SH_BIN="$BASH_BIN"
	DIRENV_BIN="$(resolve_bin direnv)"
	FLOCK="$(resolve_bin flock)"
	UNSHARE="$(resolve_bin unshare)"
	NSENTER="$(resolve_bin nsenter)"
	MOUNT="$(resolve_bin mount)"
	UMOUNT="$(resolve_bin umount)"
	NIX_BIN="$(resolve_bin nix)"

	SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
	SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
	NIX_BROKER_SCRIPT="$SCRIPT_DIR/codex-sandbox-broker"
	NIX_BROKER_CLIENT="$SCRIPT_DIR/codex-sandbox-broker-client"
	[[ -x "$NIX_BROKER_SCRIPT" ]] || die "sandbox broker '$NIX_BROKER_SCRIPT' is missing or not executable"
	[[ -r "$NIX_BROKER_CLIENT" ]] || die "sandbox broker client '$NIX_BROKER_CLIENT' is missing"

	NIX_PROFILE_BIN="$(readlink -f "$HOME/.nix-profile/bin")"
	[[ -d "$NIX_PROFILE_BIN" ]] || die "nix profile bin not found at $NIX_PROFILE_BIN"
	RESOLV="$(readlink -f /etc/resolv.conf)"
}

build_sandbox_path() {
	local entry resolved
	local -a host_path_entries

	declare -gA SEEN=()
	SANDBOX_PATH=""
	for entry in "$CODEX" "$NODE" "$GIT" "$PYTHON3" "$SANDBOX_SHELL" "$CAT" "$ENV_BIN" "$BASH_BIN" "$SH_BIN" "$DIRENV_BIN"; do
		add_path_dir "$(dirname "$entry")"
	done
	IFS=':' read -r -a host_path_entries <<<"${PATH:-}"
	for entry in "${host_path_entries[@]}"; do
		[[ -n "$entry" && -d "$entry" ]] || continue
		resolved="$(readlink -f "$entry" 2>/dev/null || true)"
		case "$resolved" in
		/nix/store/*) add_path_dir "$resolved" ;;
		esac
	done
	add_path_dir "$NIX_PROFILE_BIN"
}

workspace_uses_flake_env() {
	local line

	[[ -f "$WORKSPACE_HOST/.envrc" ]] || return 1
	while IFS= read -r line; do
		case "$line" in
		*use\ flake*) return 0 ;;
		esac
	done <"$WORKSPACE_HOST/.envrc"
	return 1
}

setup_nix_bash_env() {
	local helper_dir_host="$HOME/.codex/direnv"

	mkdir -p "$helper_dir_host"
	NIX_BASH_ENV_HOST="$helper_dir_host/bashenv.sh"
	cat >"$NIX_BASH_ENV_HOST" <<'EOF'
#!/usr/bin/env bash
__codex_nix_workspace="${CODEX_SANDBOX_WORKSPACE:-}"
__codex_nix_profile_bin="${CODEX_SANDBOX_NIX_PROFILE_BIN:-}"
__codex_direnv_bin="${CODEX_SANDBOX_DIRENV_BIN:-}"
__codex_sandbox_path="${CODEX_SANDBOX_BASE_PATH:-$PATH}"
if [[ -n "$__codex_nix_workspace" && -n "$__codex_nix_profile_bin" && -n "$__codex_direnv_bin" && -z "${CODEX_SANDBOX_DIRENV_LOADING:-}" ]]; then
	export CODEX_SANDBOX_DIRENV_LOADING=1
	export PATH="$__codex_nix_profile_bin${__codex_sandbox_path:+:$__codex_sandbox_path}"
	__codex_sandbox_path="$PATH"
	__codex_nix_export="$(
		unset BASH_ENV
		cd "$__codex_nix_workspace" && "$__codex_direnv_bin" export bash
	)" || {
		unset CODEX_SANDBOX_DIRENV_LOADING
		return 0
	}
	[[ -z "$__codex_nix_export" ]] || eval "$__codex_nix_export"
	export PATH="$__codex_sandbox_path${PATH:+:$PATH}"
	unset CODEX_SANDBOX_DIRENV_LOADING
fi
unset __codex_nix_export __codex_nix_workspace __codex_nix_profile_bin __codex_direnv_bin __codex_sandbox_path
EOF
	chmod 700 "$NIX_BASH_ENV_HOST"
}

cleanup_ssh_agent() {
	[[ -n "${SSH_AGENT_PID_VALUE:-}" ]] || return 0
	SSH_AGENT_PID="$SSH_AGENT_PID_VALUE" SSH_AUTH_SOCK="$SSH_AGENT_SOCKET_HOST" \
		"$SSH_AGENT_BIN" -k >/dev/null 2>&1 || true
	rm -rf "$SSH_AGENT_DIR"
}

cleanup_sandbox() {
	local status=$?

	release_nix_broker || true
	cleanup_ssh_agent
	return "$status"
}

setup_ssh_agent() {
	local ssh_agent_output

	SSH_AGENT_BIN="$(resolve_bin ssh-agent)"
	SSH_ADD_BIN="$(resolve_bin ssh-add)"
	SSH_AGENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/codex-sandbox-ssh.XXXXXX")"
	SSH_AGENT_SOCKET_HOST="$SSH_AGENT_DIR/agent.sock"
	SSH_AGENT_SOCKET_SANDBOX="/tmp/codex-sandbox-ssh/agent.sock"
	ssh_agent_output="$("$SSH_AGENT_BIN" -s -a "$SSH_AGENT_SOCKET_HOST")"
	eval "$ssh_agent_output" >/dev/null
	SSH_AGENT_PID_VALUE="${SSH_AGENT_PID:-}"
	[[ -n "$SSH_AGENT_PID_VALUE" && -S "$SSH_AGENT_SOCKET_HOST" ]] || die "failed to start temporary ssh-agent"
	"$SSH_ADD_BIN" "$SSH_KEY_PATH"
}

setup_host_state() {
	mkdir -p \
		"$HOME/.codex" \
		"$HOME/.cache/nix" \
		"$HOME/.config/direnv" \
		"$HOME/.config/nix" \
		"$HOME/.local/share/direnv" \
		"$HOME/.local/share/nix" \
		"$HOME/.local/state/nix"

	# shellcheck source=codex-sandbox-broker-client
	source "$NIX_BROKER_CLIENT"
	setup_nix_broker
	trap cleanup_sandbox EXIT
}

setup_features() {
	ENV_ARGS=()
	for var in OPENAI_API_KEY GITHUB_TOKEN; do
		[[ -z "${!var:-}" ]] || ENV_ARGS+=(--setenv "$var" "${!var}")
	done

	SSH_HOME_DIR_ARGS=()
	SSH_BIND_ARGS=()
	SSH_ENV_ARGS=()
	if [[ -n "$SSH_KEY_PATH" ]]; then
		setup_ssh_agent
		SSH_HOME_DIR_ARGS=(--dir "/home/$USER/.ssh")
		SSH_BIND_ARGS=(--dir /tmp/codex-sandbox-ssh --bind "$SSH_AGENT_SOCKET_HOST" "$SSH_AGENT_SOCKET_SANDBOX")
		SSH_ENV_ARGS=(--setenv SSH_AUTH_SOCK "$SSH_AGENT_SOCKET_SANDBOX")
		[[ ! -f "$HOME/.ssh/known_hosts" ]] || SSH_BIND_ARGS+=(--ro-bind "$HOME/.ssh/known_hosts" "/home/$USER/.ssh/known_hosts")
		[[ ! -f "$HOME/.ssh/config" ]] || SSH_BIND_ARGS+=(--ro-bind "$HOME/.ssh/config" "/home/$USER/.ssh/config")
	fi

	NIX_ENV_ARGS=()
	if [[ "$NIX_ENV_MODE" != "disabled" ]] && workspace_uses_flake_env; then
		NIX_ENV_MODE="direnv"
		setup_nix_bash_env
		NIX_ENV_ARGS=(
			--setenv CODEX_SANDBOX_WORKSPACE "$WORKSPACE_SANDBOX"
			--setenv CODEX_SANDBOX_NIX_PROFILE_BIN "$NIX_PROFILE_BIN"
			--setenv CODEX_SANDBOX_DIRENV_BIN "$DIRENV_BIN"
			--setenv CODEX_SANDBOX_BASE_PATH "$SANDBOX_PATH"
			--setenv BASH_ENV "$NIX_BASH_ENV_SANDBOX"
		)
	fi
}

build_sandbox_command() {
	SANDBOX_CMD=("$CODEX" "${CODEX_ARGS[@]}")
	if [[ "$DNS_DEBUG" -eq 1 ]]; then
		SANDBOX_CMD=(/bin/bash -lc '
			echo "== curl -I https://1.1.1.1 =="
			curl -I --max-time 10 https://1.1.1.1 || true
			echo; echo "== doggo www.google.com =="
			doggo www.google.com || true
			echo; echo "== ls /etc =="
			ls -la /etc || true
			echo; echo "== ls /run /run/systemd /run/systemd/resolve =="
			ls -la /run /run/systemd /run/systemd/resolve 2>/dev/null || true
		')
	fi

	if [[ -f "$WORKSPACE_HOST/.envrc" ]]; then
		SANDBOX_BASH_ENV=""
		[[ "$NIX_ENV_MODE" != "direnv" ]] || SANDBOX_BASH_ENV="$NIX_BASH_ENV_SANDBOX"
		# Approve the sandbox path before BASH_ENV can try to load it.
		# shellcheck disable=SC2016
		SANDBOX_CMD=(
			/usr/bin/env -u BASH_ENV /bin/bash -c '
				direnv_bin="$1"; workspace="$2"; bash_env="$3"; shift 3
				if ! "$direnv_bin" allow "$workspace"; then
					echo "ERROR: failed to approve $workspace/.envrc" >&2; exit 1
				fi
				[[ -z "$bash_env" ]] || export BASH_ENV="$bash_env"
				exec "$@"
			' codex-sandbox-entrypoint
			"$DIRENV_BIN" "$WORKSPACE_SANDBOX" "$SANDBOX_BASH_ENV"
			"${SANDBOX_CMD[@]}"
		)
	fi
}

assemble_mount_args() {
	HOME_DIR_ARGS=(
		--dir "/home/$USER/.nix-profile" --dir "/home/$USER/.cache"
		--dir "/home/$USER/.config" --dir "/home/$USER/.local"
		--dir "/home/$USER/.local/share" --dir "/home/$USER/.local/share/nix"
		--dir "/home/$USER/.local/state"
	)
	AGENTS_BIND_ARGS=(--dir "/home/$USER/.agents")
	[[ ! -e "$HOME/.agents" ]] || AGENTS_BIND_ARGS=(--ro-bind "$HOME/.agents" "/home/$USER/.agents")
	NIX_BIND_ARGS=(
		--bind "$HOME/.config/direnv" "/home/$USER/.config/direnv"
		--bind "$HOME/.local/share/direnv" "/home/$USER/.local/share/direnv"
		--bind "$NIX_MOUNT_ROOT/home/cache-nix" "/home/$USER/.cache/nix"
		--bind "$NIX_MOUNT_ROOT/home/config-nix" "/home/$USER/.config/nix"
		--bind "$NIX_MOUNT_ROOT/home/share-nix" "/home/$USER/.local/share/nix"
		--bind "$NIX_MOUNT_ROOT/home/state-nix" "/home/$USER/.local/state/nix"
	)
}

assemble_bwrap_args() {
	BWRAP_ARGS=(
		--unshare-user --unshare-pid --unshare-ipc --unshare-uts --hostname codex-sandbox
		--dir /nix --bind /nix /nix
		--dir /nix-lower --ro-bind "$NIX_MOUNT_ROOT/lower/nix" /nix-lower
		--proc /proc --dev /dev --tmpfs /tmp --tmpfs /run --tmpfs "/home/$USER"
		--dir "$WORKSPACE_SANDBOX_ROOT" --dir "$WORKSPACE_SANDBOX"
		"${HOME_DIR_ARGS[@]}" "${SSH_HOME_DIR_ARGS[@]}"
		--dir /usr --dir /usr/bin --dir /bin
		--bind "$NIX_FALLBACK_DIR/daemon-socket" /nix/var/nix/daemon-socket
		--ro-bind "$ENV_BIN" /usr/bin/env --ro-bind "$BASH_BIN" /bin/bash --ro-bind "$SH_BIN" /bin/sh
		--ro-bind "$SANDBOX_SHELL" "/bin/$SANDBOX_SHELL_NAME"
		--ro-bind "$ENVIRONMENT_REPO" "$ENVIRONMENT_REPO"
		--bind "$WORKSPACE_HOST" "$WORKSPACE_SANDBOX"
		"${AGENTS_BIND_ARGS[@]}"
		--bind "$HOME/.codex" "/home/$USER/.codex"
		"${NIX_BIND_ARGS[@]}" "${SSH_BIND_ARGS[@]}"
		--ro-bind "$RESOLV" /etc/resolv.conf --ro-bind /etc/ssl /etc/ssl
		--ro-bind /etc/passwd /etc/passwd --ro-bind /etc/group /etc/group
		--chdir "$WORKSPACE_SANDBOX"
		--setenv HOME "/home/$USER" --setenv SHELL "/bin/$SANDBOX_SHELL_NAME"
		--setenv TERM "${TERM:-xterm-256color}" --setenv PATH "$SANDBOX_PATH"
		--setenv LANG "${LANG:-en_US.UTF-8}" --setenv NIX_SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt
		--setenv NIX_REMOTE daemon --setenv NIX_DAEMON_SOCKET_PATH /nix/var/nix/daemon-socket/socket
		--setenv NIX_PROFILES "/nix/var/nix/profiles/default /home/$USER/.local/state/nix/profiles/profile"
		--setenv CODEX_SANDBOX_NIX_OVERLAY_MODE shared
		"${NIX_ENV_ARGS[@]}" "${ENV_ARGS[@]}" "${SSH_ENV_ARGS[@]}"
	)
}

report_configuration() {
	printf '[sandbox]\n' >&2
	log_sandbox_detail "workspace: $WORKSPACE_HOST -> $WORKSPACE_SANDBOX"
	log_sandbox_detail "nix overlay: shared broker (pid $NIX_BROKER_PID)"
	case "$NIX_ENV_MODE" in
	direnv) log_sandbox_detail "nix env: direnv preload enabled" ;;
	disabled) log_sandbox_detail "nix env: disabled" ;;
	esac
	if [[ "$DNS_DEBUG" -eq 1 ]]; then
		log_sandbox_detail "running DNS diagnostics..."
	else
		log_sandbox_detail "starting codex..."
	fi
	[[ ! -f "$WORKSPACE_HOST/.envrc" ]] || log_sandbox_detail "direnv: approving $WORKSPACE_SANDBOX/.envrc"
	[[ -z "$SSH_KEY_PATH" ]] || log_sandbox_detail "ssh: temporary agent enabled for key $SSH_KEY_PATH"
}

main() {
	parse_options "$@"
	validate_inputs
	resolve_dependencies
	build_sandbox_path
	setup_host_state
	setup_features
	assemble_mount_args
	build_sandbox_command
	assemble_bwrap_args
	report_configuration

	# Do not exec: the EXIT trap must release the broker lease and SSH agent.
	"$NSENTER" --preserve-credentials --user --mount --target "$NIX_BROKER_PID" -- \
		"$BWRAP" "${BWRAP_ARGS[@]}" -- "${SANDBOX_CMD[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
